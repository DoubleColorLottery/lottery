# Copy this file to .env, replace every production placeholder, then run:
#   chmod 600 .env
# Contract deployment ignores raw keys and uses the configured Foundry signer.

# Backend and public chain configuration
NUXT_PUBLIC_ENVIRONMENT=development
NUXT_PUBLIC_APP_MODE=live
RPC_URL=http://127.0.0.1:8545
NUXT_PUBLIC_CHAIN_RPC_URL=http://127.0.0.1:8545
NUXT_PUBLIC_CHAIN_ID=31337
NUXT_PUBLIC_CHAIN_NAME=Anvil
NUXT_PUBLIC_CHAIN_CURRENCY_SYMBOL=ETH
NUXT_PUBLIC_CHAIN_BLOCK_EXPLORER_URL=
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
LOTTERY_ADDRESS=0x0000000000000000000000000000000000000000
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_DEPLOYMENT_BLOCK=0
LOTTERY_DEPLOYMENT_BLOCK=0
ELIGIBILITY_LOG_CHUNK_SIZE=20000
ELIGIBILITY_EXCLUDED_ADDRESSES=
TRANSACTION_CONFIRMATIONS=1
NUXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NUXT_PUBLIC_LOTTERY_ADDRESS=0x0000000000000000000000000000000000000000

# Application-only secrets; leave blank in the tracked example.
BSC_MAINNET_PRIVATE_KEY=
ELIGIBILITY_SIGNER_PRIVATE_KEY=
CRON_SECRET=

# SurrealDB development defaults. Use unique credentials in production.
SURREAL_URL=http://127.0.0.1:18000
SURREAL_USER=root
SURREAL_PASS=
SURREAL_NS=lottery
SURREAL_DB=main

# Foundry contract-deployment signer. Prefer `cast wallet import deployer`
# and keep the optional password file owner-readable only (chmod 600 or 400).
FOUNDRY_SIGNER_TYPE=account
FOUNDRY_ACCOUNT=deployer
FOUNDRY_KEYSTORE=
FOUNDRY_PASSWORD_FILE=
FOUNDRY_SENDER=
FOUNDRY_DERIVATION_PATH=

# Remote signer variables (populate only for the selected signer type).
AWS_KMS_KEY_ID=
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_KEY_RING=
GCP_KEY_NAME=
GCP_KEY_VERSION=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_ADDRESS=

# Deployment options
BSC_MAINNET_RPC=
ETHERSCAN_API_KEY=
FLAP_TOKEN_SALT=
ELIGIBILITY_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
FLAP_TOKEN_NAME=DoubleBall
FLAP_TOKEN_SYMBOL=DOUBLEBALL
FLAP_TOKEN_META_URI=
FLAP_BUY_TAX_BPS=500
FLAP_SELL_TAX_BPS=500
FLAP_TAX_DURATION_SECONDS=3153600000
FLAP_ANTI_FARMER_SECONDS=86400
FLAP_INITIAL_BUY_WEI=0
